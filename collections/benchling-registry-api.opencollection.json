{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Registry API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Registry",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List registries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Name of a registry. Restricts results to those with the specified name."
              },
              {
                "name": "modifiedAt",
                "value": "",
                "type": "query",
                "description": "Datetime, in RFC 3339 format. Supports the > and < operators. Time zone defaults to UTC. Restricts results to those modified in the specified range. e.g. > 2017-04-30. Date ranges can be specified with the following nomenclature > YYYY-MM-DD AND <YYYY-MM-DD.\n"
              }
            ]
          },
          "docs": "List registries"
        },
        {
          "info": {
            "name": "Get registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ]
          },
          "docs": "Get registry"
        },
        {
          "info": {
            "name": "List batch schemas by registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/batch-schemas",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ]
          },
          "docs": "List batch schemas by registry. Deprecated - use Schemas endpoints instead."
        },
        {
          "info": {
            "name": "List box schemas by registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/box-schemas",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ]
          },
          "docs": "List box schemas by registry. Deprecated - use Schemas endpoints instead."
        },
        {
          "info": {
            "name": "List container schemas by registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/container-schemas",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ]
          },
          "docs": "List container schemas by registry. Deprecated - use Schemas endpoints instead."
        },
        {
          "info": {
            "name": "List dropdowns for a given registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/dropdowns",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID of the registry to list the dropdowns for."
              }
            ]
          },
          "docs": "List dropdowns by registry"
        },
        {
          "info": {
            "name": "List entity schemas by registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/entity-schemas",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ]
          },
          "docs": "List entity schemas by registry. Deprecated - use Schemas endpoints instead."
        },
        {
          "info": {
            "name": "List location schemas by registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/location-schemas",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ]
          },
          "docs": "List location schemas by registry. Deprecated - use Schemas endpoints instead."
        },
        {
          "info": {
            "name": "List plate schemas by registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/plate-schemas",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ]
          },
          "docs": "List plate schemas by registry. Deprecated - use Schemas endpoints instead."
        },
        {
          "info": {
            "name": "Bulk get registered entities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/registered-entities:bulk-get",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              },
              {
                "name": "entityRegistryIds",
                "value": "",
                "type": "query",
                "description": "Comma separated list of entity Registry IDs"
              }
            ]
          },
          "docs": "Bulk get registered entities"
        },
        {
          "info": {
            "name": "Register entities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/registries/:registry_id:bulk-register-entities",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID for the registry"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Attempts to move entities into the registry. Limit of 2500 entities per request. This endpoint will first check that the entities are all valid to be moved into the registry, given the namingStrategy. If any entities fail validation, no files will be moved and errors describing invalid entities is returned. If all entities pass validation, the entities are moved into the registry.\n"
        },
        {
          "info": {
            "name": "Unregister entities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/registries/:registry_id:unregister-entities",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID of the registry"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Unregisters entities and moves them to a folder"
        }
      ]
    }
  ],
  "bundled": true
}