{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Authentication API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a token for usage with authenticating via OAuth2 in subsequent API calls.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/token",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Generate a token"
        }
      ]
    }
  ],
  "bundled": true
}