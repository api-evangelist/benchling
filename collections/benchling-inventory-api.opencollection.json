{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Inventory API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Inventory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate barcodes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/registries/:registry_id:validate-barcodes",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID of the registry to validate barcodes in."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Validate barcodes on inventory objects."
        }
      ]
    }
  ],
  "bundled": true
}