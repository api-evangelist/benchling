{
  "item": [
    {
      "id": "91023553-e70c-417d-8ad0-f0e46255a212",
      "name": "Datasets",
      "description": {
        "content": "Similar to Data frames, datasets in Benchling represent tabular data that is not schematized. Datasets are saved to folders within Benchling with additional metadata, making them accessible and searchable within Benchling. Each dataset actually contains a data frame, and a data frame is required to create a dataset.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f220d5f1-ffe2-4225-b187-557589e80257",
          "name": "List datasets",
          "request": {
            "name": "List datasets",
            "description": {
              "content": "List datasets",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "50",
                  "description": "Number of results to return."
                },
                {
                  "disabled": false,
                  "key": "nextToken",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "modifiedAt",
                  "description": "Method by which to order search results. Valid sorts are modifiedAt (modified time, most recent first) createdAt (creation time, most recent first) and name (item name, alphabetical). Optionally add :asc or :desc to specify ascending or descending order. Default is modifiedAt.\n"
                },
                {
                  "disabled": false,
                  "key": "archiveReason",
                  "value": "<string>",
                  "description": "Archive reason. Restricts items to those with the specified archive reason. Use \"NOT_ARCHIVED\" to filter for unarchived items. Use \"ANY_ARCHIVED\" to filter for archived items regardless of reason. Use \"ANY_ARCHIVED_OR_NOT_ARCHIVED\" to return items for both archived and unarchived.\n"
                },
                {
                  "disabled": false,
                  "key": "createdAt",
                  "value": "<string>",
                  "description": "Datetime, in RFC 3339 format. Supports the > and < operators. Time zone defaults to UTC. Restricts results to those created in the specified range. e.g. > 2017-04-30. Date ranges can be specified with the following nomenclature > YYYY-MM-DD AND <YYYY-MM-DD.\n"
                },
                {
                  "disabled": false,
                  "key": "creatorIds",
                  "value": "<string>",
                  "description": "Comma separated list of user IDs."
                },
                {
                  "disabled": false,
                  "key": "folderId",
                  "value": "<string>",
                  "description": "ID of a folder. Restricts results to those in the folder."
                },
                {
                  "disabled": false,
                  "key": "mentionedIn",
                  "value": "<string>",
                  "description": "Comma-separated list of entry IDs. Restricts results to items mentioned in those entries.\n"
                },
                {
                  "disabled": false,
                  "key": "modifiedAt",
                  "value": "<string>",
                  "description": "Datetime, in RFC 3339 format. Supports the > and < operators. Time zone defaults to UTC. Restricts results to those modified in the specified range. e.g. > 2017-04-30. Date ranges can be specified with the following nomenclature > YYYY-MM-DD AND <YYYY-MM-DD.\n"
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Restricts results to those with the specified name."
                },
                {
                  "disabled": false,
                  "key": "nameIncludes",
                  "value": "<string>",
                  "description": "Name substring. Restricts results to those with names that include the provided substring.\n"
                },
                {
                  "disabled": false,
                  "key": "names.anyOf.caseSensitive",
                  "value": "<string>",
                  "description": "Comma-separated list of names. Maximum of 100. Restricts results to those that match any of the specified names, case sensitive.\n"
                },
                {
                  "disabled": false,
                  "key": "names.anyOf",
                  "value": "<string>",
                  "description": "Comma-separated list of names. Maximum of 100. Restricts results to those that match any of the specified names, case insensitive.  Warning - this filter can be non-performant due to case insensitivity.\n"
                },
                {
                  "disabled": false,
                  "key": "originIds",
                  "value": "<string>",
                  "description": "Comma-separated list of item IDs. Restricts results to those whose origin parent is any of the specified items."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "Comma-separated list of ids. Matches all of the provided IDs, or returns a 400 error that includes a list of which IDs are invalid.\n"
                },
                {
                  "disabled": false,
                  "key": "displayIds",
                  "value": "<string>",
                  "description": "Comma-separated list of display ids. Matches all of the provided IDs, or returns a 400 error that includes a list of which IDs are invalid.\n"
                },
                {
                  "disabled": false,
                  "key": "returning",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to return. Modifies the output shape. To return all keys at a given level, enumerate them or use the wildcard, '*'. For more information, [click here](https://docs.benchling.com/docs/getting-started-1#returning-query-parameter)."
                }
