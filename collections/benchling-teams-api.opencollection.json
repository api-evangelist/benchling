{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Teams API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/teams",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of ids. Matches all of the provided IDs, or returns a 400 error that includes a list of which IDs are invalid.\n"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Name of a team. Restricts results to those with the specified name."
              },
              {
                "name": "nameIncludes",
                "value": "",
                "type": "query",
                "description": "Name substring of a team. Restricts results to those with names that include the provided substring."
              },
              {
                "name": "names.anyOf",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of names. Maximum of 100. Restricts results to those that match any of the specified names, case insensitive.  Warning - this filter can be non-performant due to case insensitivity.\n"
              },
              {
                "name": "names.anyOf.caseSensitive",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of names. Maximum of 100. Restricts results to those that match any of the specified names, case sensitive.\n"
              },
              {
                "name": "modifiedAt",
                "value": "",
                "type": "query",
                "description": "Datetime, in RFC 3339 format. Supports the > and < operators. Time zone defaults to UTC. Restricts results to those modified in the specified range. e.g. > 2017-04-30. Date ranges can be specified with the following nomenclature > YYYY-MM-DD AND <YYYY-MM-DD.\n"
              },
              {
                "name": "mentionedIn",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of entry IDs. Restricts results to teams mentioned in those entries.\n"
              },
              {
                "name": "organizationId",
                "value": "",
                "type": "query",
                "description": "Restricts results to those in the organization."
              },
              {
                "name": "hasMembers",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of user or Benchling app IDs. Restricts results to teams that include all the given users/apps as members."
              },
              {
                "name": "hasAdmins",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of user or Benchling app IDs. Restricts results to teams that include all the given users/apps as admins."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "Token for pagination"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all teams that the caller has permission to view. The following roles have view permission:\n  - tenant admins\n  - members of the team's organization\n"
        },
        {
          "info": {
            "name": "Create team\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/teams",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a team\n"
        },
        {
          "info": {
            "name": "Get a team by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/teams/:team_id",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "ID of team to get"
              }
            ]
          },
          "docs": "Returns a team by ID if the caller has permission to view. The following roles have view permission:\n  - tenant admins\n  - members of the team's organization\n"
        },
        {
          "info": {
            "name": "Update team\n",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "/api/v2/teams/:team_id",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update team properties\n"
        },
        {
          "info": {
            "name": "List team memberships\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/teams/:team_id/memberships",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results to return."
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "Token for pagination"
              },
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "role",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all team memberships in the given team\n"
        },
        {
          "info": {
            "name": "Create team membership\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/teams/:team_id/memberships",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create team membership for the given user, role, and team\n"
        },
        {
          "info": {
            "name": "Get team membership\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/teams/:team_id/memberships/:user_id",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns team membership in the given team for the given user\n"
        },
        {
          "info": {
            "name": "Update team membership by user ID and team ID\n",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "/api/v2/teams/:team_id/memberships/:user_id",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a single team membership\n"
        },
        {
          "info": {
            "name": "Delete team membership by user ID and team ID\n",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v2/teams/:team_id/memberships/:user_id",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a single team membership\n"
        }
      ]
    }
  ],
  "bundled": true
}