{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Printers API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Printers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List printers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/registries/:registry_id/label-printers",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path",
                "description": "ID of the registry to list the printers for."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Name of a printer. Restricts results to those with the specified name."
              }
            ]
          },
          "docs": "List printers"
        }
      ]
    }
  ],
  "bundled": true
}