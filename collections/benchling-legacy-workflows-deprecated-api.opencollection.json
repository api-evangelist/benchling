{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Legacy Workflows (deprecated) API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Legacy Workflows (deprecated)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List stage run input samples",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/workflow-stage-runs/:stage_run_id/input-samples",
            "params": [
              {
                "name": "stage_run_id",
                "value": "",
                "type": "path",
                "description": "ID of the stage run to list input samples for"
              }
            ]
          },
          "docs": "List stage run input samples"
        },
        {
          "info": {
            "name": "List stage run output samples",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/workflow-stage-runs/:stage_run_id/output-samples",
            "params": [
              {
                "name": "stage_run_id",
                "value": "",
                "type": "path",
                "description": "ID of the stage run to list output samples for"
              }
            ]
          },
          "docs": "List stage run output samples"
        },
        {
          "info": {
            "name": "List stage run registered samples",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/workflow-stage-runs/:stage_run_id/registered-samples",
            "params": [
              {
                "name": "stage_run_id",
                "value": "",
                "type": "path",
                "description": "ID of the stage run to list registered samples for"
              }
            ]
          },
          "docs": "List stage run registered samples"
        },
        {
          "info": {
            "name": "List workflow stage runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/workflow-stages/:stage_id/workflow-stage-runs",
            "params": [
              {
                "name": "stage_id",
                "value": "",
                "type": "path",
                "description": "ID of the workflow stage to list runs for"
              }
            ]
          },
          "docs": "List workflow stage runs"
        },
        {
          "info": {
            "name": "List workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/workflows"
          },
          "docs": "List workflows"
        },
        {
          "info": {
            "name": "Update workflow",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "/api/v2/workflows/:workflow_id",
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path",
                "description": "ID of the workflow to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update workflow metadata"
        },
        {
          "info": {
            "name": "List workflow stages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/workflows/:workflow_id/workflow-stages",
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path",
                "description": "ID of the workflow to list stages for"
              }
            ]
          },
          "docs": "List workflow stages"
        }
      ]
    }
  ],
  "bundled": true
}