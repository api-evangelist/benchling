{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Instrument Queries API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Instrument Queries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an instrument query",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/instruments/:instrument_query_id/query",
            "params": [
              {
                "name": "instrument_query_id",
                "value": "",
                "type": "path",
                "description": "The instrument query ID"
              }
            ]
          },
          "docs": "Get an instrument query"
        }
      ]
    }
  ],
  "bundled": true
}