{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Warehouse API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Warehouse",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Benchling Warehouse credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/warehouse-credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Allows for programmatically generating credentials to connect to the Benchling warehouse. You must have a warehouse configured to access this endpoint.\nThe credentials will authenticate as the same user calling the API.\nNote that expiresIn is required - only temporary credentials are currently allowed.\n"
        }
      ]
    }
  ],
  "bundled": true
}