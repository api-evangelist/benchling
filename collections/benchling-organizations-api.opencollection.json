{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Organizations API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/organizations",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of ids. Matches all of the provided IDs, or returns a 400 error that includes a list of which IDs are invalid.\n"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Name of an organization. Restricts results to those with the specified name."
              },
              {
                "name": "nameIncludes",
                "value": "",
                "type": "query",
                "description": "Name substring of an organization. Restricts results to those with names that include the provided substring."
              },
              {
                "name": "names.anyOf",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of names. Maximum of 100. Restricts results to those that match any of the specified names, case insensitive.  Warning - this filter can be non-performant due to case insensitivity.\n"
              },
              {
                "name": "names.anyOf.caseSensitive",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of names. Maximum of 100. Restricts results to those that match any of the specified names, case sensitive.\n"
              },
              {
                "name": "modifiedAt",
                "value": "",
                "type": "query",
                "description": "Datetime, in RFC 3339 format. Supports the > and < operators. Time zone defaults to UTC. Restricts results to those modified in the specified range. e.g. > 2017-04-30. Date ranges can be specified with the following nomenclature > YYYY-MM-DD AND <YYYY-MM-DD.\n"
              },
              {
                "name": "hasMembers",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of user or Benchling app IDs. Restricts results to organizations that include all the given users/apps as members."
              },
              {
                "name": "hasAdmins",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of user or Benchling app IDs. Restricts results to organizations that include all the given users/apps as admins."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "Token for pagination"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all organizations that the caller has permission to view. The following roles have view permission:\n  - tenant admins\n  - members of the organization\n"
        },
        {
          "info": {
            "name": "Get an organization by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/organizations/:organization_id",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "ID of organization to get"
              }
            ]
          },
          "docs": "Returns an organization by ID if the caller has permission to view. The following roles have view permission:\n  - tenant admins\n  - members of the organization\n"
        },
        {
          "info": {
            "name": "List organization memberships\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/organizations/:organization_id/memberships",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results to return."
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "Token for pagination"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "role",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all organization memberships in the given organization\n"
        },
        {
          "info": {
            "name": "Create organization membership\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/organizations/:organization_id/memberships",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create organization membership for the given user, role, and organization\n"
        },
        {
          "info": {
            "name": "Get organization membership\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/organizations/:organization_id/memberships/:user_id",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns organization membership in the given organization for the given user\n"
        },
        {
          "info": {
            "name": "Update organization membership by user ID and organization ID\n",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "/api/v2/organizations/:organization_id/memberships/:user_id",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a single organization membership\n"
        },
        {
          "info": {
            "name": "Delete organization membership by user ID and organization ID\n",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v2/organizations/:organization_id/memberships/:user_id",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a single organization membership\n"
        }
      ]
    }
  ],
  "bundled": true
}