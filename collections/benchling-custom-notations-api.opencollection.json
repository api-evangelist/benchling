{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Custom Notations API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/api/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Notations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List custom notations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/custom-notations",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results to return. Defaults to 50, maximum of 100.\n"
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "Token for pagination"
              }
            ]
          },
          "docs": "List all available custom notations for specifying modified nucleotide sequences"
        }
      ]
    }
  ],
  "bundled": true
}